Reference patch for anomalyco/opencode (branch dev) that switches the
claude-agent provider's `ClaudeIO` to the remote stub when
`CLAUDE_STUB_ENDPOINT` is set. Session projection goes over the sess-v1 RPC;
the stdio side keeps using the SDK's own spawn, with OPENCODE_CLAUDE_PATH
pointing at the `stub-client` binary.

Apply from the opencode repo root: git apply claude-io-remote.patch

--- a/packages/core/src/plugin/provider/claude-agent/claude/io.ts
+++ b/packages/core/src/plugin/provider/claude-agent/claude/io.ts
@@
 import type { Options } from "@anthropic-ai/claude-agent-sdk"
+import { connect } from "node:net"
 import { which } from "../../../../util/which.js"
@@
 export const real: Interface = {
@@
   },
 }
+
+// Remote variant for the two-machine split: session ops are projected to a
+// claude-io-stub server (machine B) over sess-v1 JSON-lines RPC. The stdio
+// side still spawns a local binary — OPENCODE_CLAUDE_PATH points at
+// stub-client — so the Agent SDK control protocol and its in-process MCP
+// bridge are carried verbatim over the relay. `spawn` stays undefined on
+// purpose: the SDK keeps spawning `pathToClaudeCodeExecutable` itself.
+export const remote = (): Interface => {
+  const endpoint = process.env.CLAUDE_STUB_ENDPOINT ?? ""
+  const rpc = (payload: Record<string, unknown>) =>
+    new Promise<Record<string, any>>((resolve, reject) => {
+      const at = endpoint.lastIndexOf(":")
+      const socket = connect(Number(endpoint.slice(at + 1)), endpoint.slice(0, at), () => {
+        socket.write(`${JSON.stringify({ proto: "sess-v1" })}\n`)
+        socket.write(`${JSON.stringify({ id: 1, ...payload })}\n`)
+      })
+      let buffer = ""
+      socket.on("data", (chunk) => {
+        buffer += chunk.toString()
+        let cut: number
+        while ((cut = buffer.indexOf("\n")) >= 0) {
+          const line = buffer.slice(0, cut)
+          buffer = buffer.slice(cut + 1)
+          if (!line) continue
+          const message = JSON.parse(line) as Record<string, any>
+          if (message.id === 1) {
+            socket.destroy()
+            if (message.ok) resolve(message)
+            else reject(new Error(String(message.error ?? "stub rpc failed")))
+            return
+          }
+        }
+      })
+      socket.on("error", reject)
+    })
+  return {
+    spawn: undefined,
+    which: () => process.env.OPENCODE_CLAUDE_PATH || which("claude") || undefined,
+    env: () => process.env,
+    sessionExists: async (sessionID) =>
+      Boolean((await rpc({ op: "exists", session: sessionID })).exists),
+    fork: async (sessionID, messageID) => {
+      const out = await rpc({ op: "fork", session: sessionID, upTo: messageID })
+      return {
+        sessionID: String(out.sessionId),
+        messages: new Map(out.pairs as Array<[string, string]>),
+      }
+    },
+    remove: async (sessionID) => {
+      await rpc({ op: "delete", session: sessionID })
+    },
+  }
+}
+
+export const select = (): Interface => (process.env.CLAUDE_STUB_ENDPOINT ? remote() : real)
